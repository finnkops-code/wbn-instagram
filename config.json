    "topics": {
      "title won": {
        "points": 45,
        "pattern": "\\b(champions?|championship|crowned|title|gold medal)\\b|\\b(wins?|won|sweeps?|swept|clinch\\w*)\\b.*\\b(series|title|crown|classic|pennant)\\b"
