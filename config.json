        "points": 28,
        "pattern": "\\b(signs?|signed|signing|trade[ds]?|acquires?|free agent|free agency|posting|posted|contract|extension|retires?|retirement|fired|hired as manager|new manager)\\b"
      },
      "playoffs": {
        "points": 24,
        "pattern": "\\b(playoffs?|postseason|game [1-7]|series lead|clinch\\w*|eliminat\\w*|decider|semi-?finals?|finals?|final four|pennant|wild card|force[sd]? game)\\b"
      },
      "star performance": {
        "points": 12,
        "pattern": "\\b(walk[- ]?off|grand slam|shutout|one-hitter|one-hit|strikes out \\d+|\\d+ strikeouts|two homers|three homers)\\b"
      },
      "game recap": {
        "points": 6,
        "pattern": "\\b(beat|beats|tops|edges|routs|lifts|past|over|win|wins|downs)\\b"
      }
    },
    "penalties": {
      "youth/juniors": {
        "points": -18,
        "pattern": "\\b(u-?1[0-9]|u-?2[0-3]|youth|junior|juniors|little league)\\b"
      },
      "admin/organisational": {
        "points": -12,
        "pattern": "\\b(coach(es|ing)? staff|coaching|commissioner|board|eligible|roster|schedule|delays?|postponed|rain|prospect pipeline|affiliat\\w*)\\b"
      },
      "preview": {
        "points": -6,
