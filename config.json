        "points": 32,
        "pattern": "\\b(world series|japan series|korean series|taiwan series|caribbean series|serie del caribe|holland series|world baseball classic|european championship)\\b"
      },
      "major award": {
        "points": 38,
        "pattern": "\\b(mvp|cy young|sawamura|rookie of the year|hall of fame|gold glove|silver slugger|manager of the year)\\b"
      },
      "historic feat": {
        "points": 35,
        "pattern": "\\b(no-hitter|perfect game|record|first[- ]ever|historic|history|cycle|four homers|milestone|\\d{3}(th)? (career )?(homer|home run|win|strikeout)s?)\\b"
      },
